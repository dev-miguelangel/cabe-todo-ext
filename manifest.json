{
  "manifest_version": 3,
  "name": "Cabe Todo",
  "version": "0.4.0",
  "description": "Planifica tus tareas en mañana y tarde, y sabe si te alcanza el día.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/pages/panel/panel.html"
  },
  "action": {
    "default_title": "Abrir Cabe Todo",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Abrir Cabe Todo"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/float-timer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
