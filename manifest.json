{
  "manifest_version": 3,
  "name": "Cabe Todo",
  "version": "1.0.7",
  "minimum_chrome_version": "116",
  "description": "Planifica tu día en bloques y sabe a tiempo si te alcanza: tareas, reuniones, rutinas y documentación en el panel lateral.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "offscreen",
    "scripting",
    "identity"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/pages/panel/panel.html"
  },
  "action": {
    "default_title": "Abrir Cabe Todo",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Abrir Cabe Todo"
    }
  }
}
